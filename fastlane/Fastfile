require "fileutils"

default_platform(:ios)

platform :ios do
  desc "Sincronizza scheda e screenshot localizzati senza inviare una build"
  lane :sync_app_store_listing do
    version = File.read(File.expand_path("../pubspec.yaml", __dir__))
      .match(/^version:\s*([0-9]+\.[0-9]+\.[0-9]+)/)[1]
    key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
    key_path = ENV.fetch(
      "APP_STORE_CONNECT_KEY_PATH",
      File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    )
    UI.user_error!("Chiave App Store Connect non trovata: #{key_path}") unless File.file?(key_path)

    source_metadata_path = File.expand_path("../app_store/metadata", __dir__)
    source_screenshots_path = File.expand_path("../app_store/screenshots", __dir__)
    release_path = File.expand_path("../build/app_store_listing", __dir__)
    metadata_path = File.join(release_path, "metadata")
    screenshots_path = File.join(release_path, "screenshots")
    locale_map = {
      "it" => "it-IT",
      "en-US" => "en-US",
      "fr-FR" => "fr-FR",
      "de-DE" => "de-DE"
    }

    FileUtils.rm_rf(release_path)
    FileUtils.mkdir_p(metadata_path)
    locale_map.each do |store_locale, screenshot_locale|
      # I metadati usa i codici Apple; i fixture grafici resta coi codici app.
      FileUtils.cp_r(
        File.join(source_metadata_path, store_locale),
        File.join(metadata_path, store_locale)
      )
      # El nome pubblico resta quel già riservà; i nomi generici tradotti pol confliggere.
      FileUtils.rm_f(File.join(metadata_path, store_locale, "name.txt"))
      FileUtils.mkdir_p(File.join(screenshots_path, store_locale))
      Dir.glob(File.join(source_screenshots_path, screenshot_locale, "*.png")).each do |image|
        FileUtils.cp(image, File.join(screenshots_path, store_locale, File.basename(image)))
      end
    end

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    deliver(
      api_key: api_key,
      app_identifier: "it.meska.rubricaassociati",
      app_version: version,
      metadata_path: metadata_path,
      screenshots_path: screenshots_path,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Invia una build già elaborata alla revisione App Store"
  lane :submit_app_store do |options|
    version = options[:version].to_s
    build_number = options[:build_number].to_s

    UI.user_error!("Manca version:<x.y.z>") if version.empty?
    UI.user_error!("Manca build_number:<numero>") if build_number.empty?

    key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
    key_path = ENV.fetch(
      "APP_STORE_CONNECT_KEY_PATH",
      File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    )

    UI.user_error!("Chiave App Store Connect non trovata: #{key_path}") unless File.file?(key_path)

    source_metadata_path = File.expand_path("../app_store/metadata", __dir__)
    release_metadata_path = File.expand_path(
      "../build/app_store_release_metadata",
      __dir__
    )

    # Copiémo solo le note: nome e scheda App Store no i va tocà a ogni release.
    FileUtils.rm_rf(release_metadata_path)
    Dir.glob(File.join(source_metadata_path, "*", "release_notes.txt")).each do |notes_path|
      locale = File.basename(File.dirname(notes_path))
      locale_path = File.join(release_metadata_path, locale)
      FileUtils.mkdir_p(locale_path)
      FileUtils.cp(notes_path, File.join(locale_path, "release_notes.txt"))
    end

    # Sta ciave ga el ruolo App Manager: niente login Apple ID o codici 2FA.
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    deliver(
      api_key: api_key,
      app_identifier: "it.meska.rubricaassociati",
      app_version: version,
      build_number: build_number,
      metadata_path: release_metadata_path,
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      # Se Apple sta ancora valutando la release precedente, la nova la sostituise.
      reject_if_possible: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
